# ============================================================
# EARTHSCOPE — ENVIRONMENT CONFIGURATION
# ============================================================

# Google Gemini API Key (Required for AI Geospatial Analyst & conversational reasoning)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# CARTO Basemaps API Key (Required for unwatermarked CARTO Voyager basemaps)
# Get a free key from: https://carto.com/basemaps/apikey/
VITE_CARTO_API_KEY=


# STAC Satellite Endpoints (Public Open Data - No authentication required)
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# OpenStreetMap Nominatim Geocoding API
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
